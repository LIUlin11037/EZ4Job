# ============================================================
# EzJob — 敏感文件与本地临时文件
# 原则：凡是含个人信息、密钥、运行记录的文件一律不入库
# ============================================================

# ---------- 个人配置（含 API Key、打招呼语、个人偏好） ----------
user_config.json
user_config.local.json
user_config.*.json
!user_config.example.json

# ---------- 个人简历（真实简历不上传，模板保留） ----------
resume.md
resume-lock.md
resume_*.md
*.pdf
*.doc
*.docx

# ---------- 运行日志（含岗位标题、JD 全文、聊天动作） ----------
job_actions.jsonl
job_decisions.jsonl
*.jsonl
server.out.log
server.err.log
*.log

# ---------- 密钥 / 环境变量 ----------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
client_secret*.json

# ---------- 本地缓存与产物 ----------
cache.json
goodjobs.zip
test.*
PROJECT_MEMORY.md
.codex

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- WorkBuddy / 编辑器本地状态 ----------
.workbuddy/
.idea/
.vscode/
*.swp
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
